# One line-ending for every text file, on every machine. Without this a Windows
# checkout with core.autocrlf rewrites files to CRLF: index.html's inline script
# then hashes differently from the one Cloudflare builds (the CSP pins that
# hash), and every edit shows up as a whole-file diff.
* text=auto eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.woff2 binary
*.zip   binary
