# Copy to .env and fill in from your Supabase project settings
# (Dashboard > Project Settings > Data API / API Keys).
# Only these two are safe in the client — RLS enforces every rule at the DB.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Web Push VAPID PUBLIC key (safe in the client). Generate a pair with
# `npx web-push generate-vapid-keys`; the PRIVATE half is a function secret
# (supabase secrets set VAPID_PRIVATE_KEY=…), never put it here.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# NEVER put the service_role key or the database password in here or anywhere
# that ships to the browser. The service_role key bypasses RLS entirely.
